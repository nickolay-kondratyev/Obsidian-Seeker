{
    "name": "seeker",
    "version": "1.1.11",
    "description": "Obsidian plugin for on-device hybrid semantic and lexical vault search.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "node esbuild.config.mjs production",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:e2e:retrieval": "E2E=1 vitest run e2e/retrieval.e2e.test.ts",
        "test:e2e:obsidian": "bash scripts/run-e2e-obsidian.sh",
        "test:e2e": "npm run test:e2e:retrieval && npm run test:e2e:obsidian",
        "bench": "node scripts/bench.mjs --default-device=wasm",
        "bench:host": "node scripts/bench.mjs --default-device=webgpu",
        "bench:setup": "playwright-core install chromium",
        "build:e2e-dataset": "node scripts/build-e2e-dataset.mjs",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "setup:obsidian": "bash scripts/setup-obsidian-bin.sh"
    },
    "keywords": [
        "obsidian",
        "semantic-search",
        "embeddings",
        "transformers.js"
    ],
    "author": "nickolaykondratyev",
    "license": "MIT",
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@types/node": "^22.0.0",
        "esbuild": "^0.24.0",
        "fake-indexeddb": "^6.2.5",
        "obsidian": "^1.7.2",
        "playwright-core": "^1.62.1",
        "typescript": "^5.6.0",
        "vitest": "^2.1.0",
        "yaml": "^2.9.0"
    },
    "dependencies": {
        "minisearch": "^7.2.0"
    }
}
